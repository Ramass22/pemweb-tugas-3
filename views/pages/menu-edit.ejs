<%- include('../partials/header', { pageTitle: pageTitle }) %>
    <div class="card" style="max-width: 600px; margin: 1.5rem auto;">
        <h2>Edit Produk #<%= produk.id %>
        </h2>
        <form action="/edit/<%= produk.id %>" method="POST">
            <div style="margin-bottom: 1rem;">
                <label for="nama_produk">Nama Produk:</label><br>
                <input type="text" id="nama_produk" name="nama_produk" value="<%= produk.nama_produk %>" required
                    style="width: 100%; padding: 0.5rem;">
            </div>
            
            <div style="margin-bottom: 1rem;">
                <label for="harga">Harga (Rp):</label><br>
                <input type="number" id="harga" name="harga" value="<%= produk.harga %>" required style="width: 
100%; padding: 0.5rem;">
            </div>
            
            <button type="submit" class="btn btn--primary" style="padding: 0.6rem 1.2rem; background: #0284c7; color:
rgb(240, 242, 250);  border-radius: 4px; cursor: pointer;">update <menu></menu></button>
            <a href="/" style="margin-left: 1rem; color: #fa4903;">Batal</a>
        </form>
    </div>
    <%- include('../partials/footer') %>